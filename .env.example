# Copy this file to .env and fill it in. Never commit .env.
# Get the values from @liltaya (C) privately, not through GitHub or a group chat.

# Where the Piezas services live. Not a secret: copy this line as it is.
# Without it, every Piezas call from your laptop goes to your own computer.
PIEZAS_API_URL=https://api.piezas.ai

# Identifies our app to Piezas. Server only. Ask @liltaya for it.
PIEZAS_API_KEY=

# Claude API key for the scam check. Server only, never in browser code.
# Optional: without it, checks use the keyword rules alone.
ANTHROPIC_API_KEY=
